# Configuración de Supabase (Frontend & Backend)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-publica-anonima-de-supabase"

# Servidor Local Express / API
PORT=3000

# Envío de Correos (SMTP / Gmail App Password)
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="tu-contraseña-de-aplicacion"

# Opcional: Servicio Resend (para Serverless Functions en Vercel)
RESEND_API_KEY="re_123456789"
